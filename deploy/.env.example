# ============================================================
# 博客系统环境变量示例（deploy/.env.example）
# 用法：cp .env.example .env 后修改真实值
# 安全：本文件只放**占位值**，严禁提交真实密钥；.env 已被 deploy/.gitignore 忽略
# ============================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=blogs_db
MYSQL_USER=blogs
MYSQL_PASSWORD=change_me_blog_password

# ---------- 服务端口 ----------
BACKEND_PORT=8080
FRONTEND_PORT=80
MYSQL_PORT=3306
# REDIS_PORT=6379

# ---------- 应用密钥（占位，严禁真实值） ----------
# 生产部署时必须替换为足够长的随机值
JWT_SECRET=change_me_jwt_secret_at_least_32_chars

# ---------- Spring 环境 ----------
# 默认 dev；容器内通过环境变量覆盖数据源，不依赖 application-dev.yml 的 localhost
SPRING_PROFILES_ACTIVE=dev
