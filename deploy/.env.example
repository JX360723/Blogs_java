# ============================================================
# 博客系统环境变量示例（deploy/.env.example）
# 用法：cd deploy && cp .env.example .env，然后逐项改掉 change_me_*
# 安全：本文件只放**占位值**，严禁提交真实密钥；.env 已被 deploy/.gitignore 忽略
# 校验：compose 里这些变量都是 `${VAR}` 直接引用，缺项会导致 mysql 起不来或后端连不上库
# ============================================================

# ---------- MySQL ----------
# root 密码：仅用于容器内管理（备份、进库排查），不暴露给应用
MYSQL_ROOT_PASSWORD=change_me_root_password
# 库名：schema.sql 会自动在该库内建表（docker-entrypoint-initdb.d）
MYSQL_DATABASE=blogs_db
# 业务账号：后端用这个账号连库，不要用 root
MYSQL_USER=blogs
MYSQL_PASSWORD=change_me_blog_password

# ---------- 服务端口（宿主） ----------
BACKEND_PORT=8080
FRONTEND_PORT=80
MYSQL_PORT=3306
# REDIS_PORT=6379

# ---------- 应用密钥 ----------
# JWT 签名密钥：必须换成足够长的随机串（≥32 字节），否则 token 可被伪造
# 生成示例：openssl rand -base64 48
JWT_SECRET=change_me_jwt_secret_at_least_32_chars

# 首个管理员密码：admin_user 表为空时用它创建 admin 账号
# 长度限制 6-64（后端会校验）：太短会跳过创建且只打一条 ERROR 日志，表现为「登录永远失败」
# 改这个值对已存在的库不生效 —— 需要 docker compose down -v 重建，或手动改库
ADMIN_INIT_PASSWORD=change_me_admin_password_at_least_8_chars

# ---------- Spring 环境 ----------
# prod：不自动建表（表由 MySQL 容器首启执行 schema.sql）、不打 SQL、数据源全走环境变量
# 本地不用 Docker 调试时可改成 dev（dev 会连 localhost:3306 并自动建表）
SPRING_PROFILES_ACTIVE=prod
