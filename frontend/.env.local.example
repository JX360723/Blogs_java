# ============================================================
# 真实后端联调配置（复制本文件为 frontend/.env.local 使用）
# ============================================================
# 注意：
#   - 默认开发/演示走 mock（VITE_USE_MOCK=true，见 .env.example）
#   - 要连真实后端时，复制本文件为 .env.local 即可，无需改任何代码
#   - .env.local 会被 git 忽略（见 .gitignore），不会提交进仓库

# API 基址（dev 经 vite proxy /api → http://localhost:8080，与后端统一 /api/v1 前缀）
VITE_API_BASE_URL=/api/v1

# mock 开关：false = 关闭 mock，请求走真实后端接口
VITE_USE_MOCK=false
